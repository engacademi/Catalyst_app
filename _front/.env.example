# FastAPI origin, used by the server-side /api/backend/v1 rewrite.
# Set this for BOTH Production and Preview on Vercel. Existing
# NEXT_PUBLIC_API_BASE_URL settings are also supported for compatibility.
API_BASE_URL=http://localhost:8000

# Clerk staff sign-in. Leave empty locally to use the dev user picker (API must run with AUTH_MODE=dev).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
