# Local development. Railway sets these as service variables instead.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/courtside
PUBLIC_WEB_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# dev: trust the X-Dev-User header (development/test only). clerk: verify Clerk session tokens.
AUTH_MODE=dev
# Required when AUTH_MODE=clerk. The issuer is your Clerk Frontend API URL.
AUTH_ISSUER=
CLERK_JWKS_URL=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

ASSUMED_MATCH_MINUTES=60
LOG_LEVEL=INFO
